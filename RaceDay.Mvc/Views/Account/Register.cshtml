@model RegisterVm
@{ViewData["Title"]="Register";}<div class="row justify-content-center"><div class="col-md-7 col-lg-6"><div class="card p-4 p-md-5"><div class="eyebrow">Be part of the action</div><h1 class="section-title">Create your account</h1><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="FullName" class="form-label">Full name</label><input asp-for="FullName" class="form-control"/><span asp-validation-for="FullName" class="text-danger"></span></div><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"/><span asp-validation-for="Email" class="text-danger"></span></div><div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control"/><div class="form-text">Use at least 8 characters.</div><span asp-validation-for="Password" class="text-danger"></span></div><div class="mb-3"><label asp-for="Role" class="form-label">I am registering as</label><select asp-for="Role" class="form-select"><option>Participant</option><option>Organiser</option></select></div><button class="btn btn-warning w-100 fw-bold">Create account</button></form></div></div></div>
