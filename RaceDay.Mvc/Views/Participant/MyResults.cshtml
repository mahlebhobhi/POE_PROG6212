@model List<ResultDto>
@{ViewData["Title"]="My results";}<div class="eyebrow">Personal race history</div><h1 class="section-title">My results</h1><p class="text-secondary">Finishing times and positions from completed events.</p>@if(Model.Count==0){<div class="empty"><h4>Your results will appear here</h4><p>Once an organiser publishes your race result, it will be listed here.</p></div>}else{<div class="card p-3 table-responsive"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.EventName</td><td>@r.EventDate.ToString("dd MMM yyyy")</td><td>@r.Category</td><td>@r.FinishTime</td><td><strong>@r.FinishingPosition of @r.TotalFinishers</strong></td></tr>}</tbody></table></div>}
