@model List<EnrollmentDto>
@{ViewData["Title"]="My events";}<div class="eyebrow">Your race calendar</div><h1 class="section-title">My events</h1><p class="text-secondary">Your personal enrolments and entry statuses.</p>@if(Model.Count==0){<div class="empty"><h4>No entries yet</h4><p>Find an event and make your first entry.</p><a asp-action="Index" class="btn btn-warning">Browse events</a></div>}else{<div class="row g-3">@foreach(var e in Model){<div class="col-md-6"><div class="card p-4"><div class="d-flex justify-content-between"><h5 class="fw-bold">@e.Event?.Name</h5><span class="badge badge-open">@e.Status</span></div><p class="text-secondary mb-1">@e.Event?.EventDate.ToString("dd MMM yyyy") · @e.Event?.Location</p><p class="mb-0">Category: <strong>@e.Category</strong></p></div></div>}</div>}
