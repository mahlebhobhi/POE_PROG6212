@model List<EventDto>
@{ViewData["Title"]="Find events";}
<div class="eyebrow">Participant hub</div><h1 class="section-title">Find your next event</h1><p class="text-secondary">Filter the calendar and choose the challenge that suits you.</p><form method="get" class="card p-3 mb-4"><div class="row g-2"><div class="col-md-6"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Search event or location"/></div><div class="col-md-3"><select name="type" class="form-select"><option value="">All event types</option><option selected="@(ViewBag.Type as string=="Run")">Run</option><option selected="@(ViewBag.Type as string=="Walk")">Walk</option><option selected="@(ViewBag.Type as string=="Cycle")">Cycle</option></select></div><div class="col-md-3 d-grid"><button class="btn btn-warning fw-bold">Filter events</button></div></div></form>
<div class="row g-4">@foreach(var e in Model){<div class="col-md-6 col-lg-4"><div class="card h-100">@if(!string.IsNullOrWhiteSpace(e.BannerImageUrl)){<img class="card-img-top" src="@e.BannerImageUrl" alt="@e.Name banner"/>}else{<div class="card-img-top bg-dark text-warning d-flex justify-content-center align-items-center fs-1">🏁</div>}<div class="card-body"><span class="badge text-bg-warning">@e.EventType</span><h5 class="fw-bold mt-2">@e.Name</h5><p class="text-secondary">@e.Description</p><p class="small">📅 @e.EventDate.ToString("dd MMM yyyy")<br/>📍 @e.Location<br/>🏃 @e.DistanceKm km</p><a asp-action="Details" asp-route-id="@e.Id" class="btn btn-dark">View event</a></div></div></div>}</div>
