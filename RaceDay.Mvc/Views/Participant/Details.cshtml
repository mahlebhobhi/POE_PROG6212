@model EventDto
@{ViewData["Title"]=Model.Name;var cats=ViewBag.Categories as List<CategoryDto>??new();}
@if(!string.IsNullOrWhiteSpace(Model.BannerImageUrl)){<img src="@Model.BannerImageUrl" class="w-100 rounded-4 mb-4" style="max-height:320px;object-fit:cover" alt="@Model.Name banner"/>}<div class="eyebrow">@Model.EventType · @Model.DistanceKm km</div><h1 class="section-title">@Model.Name</h1><p class="lead">@Model.Description</p><div class="card p-3 mb-4"><div class="row"><div class="col-md-6">📅 <strong>@Model.EventDate.ToString("dddd, dd MMMM yyyy · HH:mm")</strong></div><div class="col-md-6">📍 <strong>@Model.Location</strong></div></div></div><h3 class="section-title">Choose your category</h3><div class="row g-3">@foreach(var c in cats){<div class="col-md-6"><div class="card p-4 h-100"><h5>@c.Name</h5><p class="text-secondary">Age @c.MinimumAge – @(c.MaximumAge?.ToString()??"Open") · @c.DistanceKm km</p><form asp-action="Enrol" method="post"><input type="hidden" name="eventId" value="@Model.Id"/><input type="hidden" name="categoryId" value="@c.Id"/><button class="btn btn-warning fw-bold">Enter this event</button></form></div></div>}</div>
