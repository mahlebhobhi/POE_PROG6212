<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link href="~/css/site.css" rel="stylesheet"/></head><body>
<nav class="navbar navbar-expand-lg navbar-dark raced-nav"><div class="container"><a class="navbar-brand fw-black" asp-controller="Home" asp-action="Index">🏁 RaceDay</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav me-auto">
@if(Context.Session.GetString("UserRole")=="Organiser"){<li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Index">Dashboard</a></li><li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Events">Manage events</a></li>}
else if(Context.Session.GetString("UserRole")=="Participant"){<li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Index">Find events</a></li><li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My events</a></li><li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My results</a></li>}
else{<li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Events</a></li>}
</ul><div class="d-flex gap-2 align-items-center">@if(Context.Session.GetInt32("UserId")!=null){<a class="nav-link text-white" asp-controller="Profile" asp-action="Index">@Context.Session.GetString("UserName") · Profile</a><a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Logout">Log out</a>}else{<a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Log in</a><a class="btn btn-warning btn-sm fw-bold" asp-controller="Account" asp-action="Register">Join RaceDay</a>}</div></div></div></nav>
<main class="container py-4"><partial name="_Alerts"/>@RenderBody()</main><footer class="footer mt-5 py-4"><div class="container d-flex justify-content-between"><span>© @DateTime.Now.Year RaceDay</span><span>Run • Walk • Cycle</span></div></footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
