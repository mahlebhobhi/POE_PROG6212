@model List<EventDto>
@{ViewData["Title"]="Discover events";}
<section class="hero mb-5"><div class="eyebrow">Your next finish line starts here</div><h1>Find your pace.<br/>Make your mark.</h1><p class="lead col-lg-7">Discover community runs, walks and cycling events. Choose your challenge and join the RaceDay community.</p><a class="btn btn-warning btn-lg fw-bold mt-2" asp-controller="Account" asp-action="Register">Get started <span aria-hidden="true">→</span></a></section>
<div class="d-flex justify-content-between align-items-end mb-3"><div><div class="eyebrow">On the calendar</div><h2 class="section-title">Upcoming events</h2></div><a asp-controller="Account" asp-action="Register" class="btn btn-outline-dark">Join to enrol</a></div>
<div class="row g-4">@foreach(var e in Model.Where(x=>x.EventDate>=DateTime.Today)){<div class="col-md-6 col-lg-4"><div class="card h-100">@if(!string.IsNullOrEmpty(e.BannerImageUrl)){<img class="card-img-top" src="@e.BannerImageUrl" alt="@e.Name banner"/>}else{<div class="card-img-top d-flex align-items-center justify-content-center bg-dark text-warning fs-1">🏁</div>}<div class="card-body"><span class="badge text-bg-warning">@e.EventType</span><h5 class="mt-2 fw-bold">@e.Name</h5><p class="text-secondary">@e.Description</p><div class="small">📅 @e.EventDate.ToString("dd MMM yyyy")<br/>📍 @e.Location · @e.DistanceKm km</div></div></div></div>}</div>
