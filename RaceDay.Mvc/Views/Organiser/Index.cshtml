@model List<EventDto>
@{ViewData["Title"]="Organiser dashboard";int total=ViewBag.Enrolments??0;}
<div class="d-flex justify-content-between align-items-center mb-4"><div><div class="eyebrow">Organiser workspace</div><h1 class="section-title">Dashboard</h1><p class="text-secondary">Your events at a glance.</p></div><a asp-action="Create" class="btn btn-warning fw-bold">＋ Create event</a></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="stat"><span class="text-secondary">Events created</span><strong>@Model.Count</strong></div></div><div class="col-md-4"><div class="stat"><span class="text-secondary">Total enrolments</span><strong>@total</strong></div></div><div class="col-md-4"><div class="stat"><span class="text-secondary">Upcoming events</span><strong>@Model.Count(x=>x.EventDate>=DateTime.Today)</strong></div></div></div>
<h3 class="section-title mb-3">Your event schedule</h3><div class="table-responsive card p-3"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Distance</th><th>Manage</th></tr></thead><tbody>@foreach(var e in Model){<tr><td class="fw-bold">@e.Name</td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@e.Location</td><td>@e.DistanceKm km</td><td><a asp-action="Edit" asp-route-id="@e.Id">Edit</a> · <a asp-action="Categories" asp-route-id="@e.Id">Categories</a> · <a asp-action="Enrolments" asp-route-id="@e.Id">Entries</a> · <a asp-action="Results" asp-route-id="@e.Id">Results</a></td></tr>}</tbody></table></div>
