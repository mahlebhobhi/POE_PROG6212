@model List<ResultDto>
@{var ev=ViewBag.Event as EventDto;var entries=ViewBag.Enrolments as List<EnrollmentDto>??new();ViewData["Title"]="Results entry";}
<div class="eyebrow">Organiser · Race timing</div><h1 class="section-title">Results · @ev?.Name</h1><div class="row g-4"><div class="col-lg-5"><div class="card p-4"><h4>Record a result</h4><form asp-action="RecordResult" method="post"><input type="hidden" name="eventId" value="@ev?.Id"/><div class="mb-3"><label class="form-label">Participant entry</label><select name="EnrollmentId" class="form-select" required>@foreach(var e in entries){<option value="@e.Id">@e.ParticipantName · @e.Category</option>}</select></div><div class="mb-3"><label class="form-label">Finish time (HH:MM:SS)</label><input name="FinishTime" class="form-control" value="00:30:00" required pattern="[0-9]{2}:[0-9]{2}:[0-9]{2}"/></div><div class="mb-3"><label class="form-label">Finishing position</label><input name="FinishingPosition" type="number" min="1" value="1" class="form-control" required/></div><button class="btn btn-warning">Publish result</button></form></div></div><div class="col-lg-7"><div class="card p-4"><h4>Published results</h4><table class="table"><thead><tr><th>Position</th><th>Participant</th><th>Finish time</th></tr></thead><tbody>@foreach(var r in Model.OrderBy(x=>x.FinishingPosition)){<tr><td><strong>#@r.FinishingPosition</strong></td><td>@r.Participant</td><td>@r.FinishTime</td></tr>}</tbody></table></div></div></div>
