@model List<CategoryDto>
@{ViewData["Title"]="Event categories";var ev=ViewBag.Event as EventDto;int eid=(int)ViewBag.EventId;}
<div class="mb-4"><div class="eyebrow">Event setup</div><h1 class="section-title">Categories · @ev?.Name</h1><p class="text-secondary">Create age and distance categories participants can select when enrolling.</p></div><div class="row g-4"><div class="col-lg-5"><div class="card p-4"><h4>Add a category</h4><form asp-action="AddCategory" method="post"><input type="hidden" name="EventId" value="@eid"/><div class="mb-3"><label class="form-label">Category name</label><input name="Name" class="form-control" required placeholder="e.g. 10km Open"/></div><div class="row"><div class="col"><label class="form-label">Minimum age</label><input name="MinimumAge" type="number" min="0" class="form-control"/></div><div class="col"><label class="form-label">Maximum age</label><input name="MaximumAge" type="number" min="0" class="form-control"/></div></div><div class="mt-3 mb-3"><label class="form-label">Distance (km)</label><input name="DistanceKm" type="number" step="0.1" min="0.1" class="form-control"/></div><button class="btn btn-warning">Add category</button></form></div></div><div class="col-lg-7"><div class="card p-4"><h4>Available categories</h4>@if(Model.Count==0){<p class="text-secondary">No categories have been added yet.</p>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Category</th><th>Age range</th><th>Distance</th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.Name</td><td>@c.MinimumAge – @(c.MaximumAge?.ToString()??"Open")</td><td>@c.DistanceKm km</td></tr>}</tbody></table></div>}</div></div></div>
