@model List<EventDto>
@{ViewData["Title"]="Manage events";}<div class="d-flex justify-content-between mb-4"><div><div class="eyebrow">Organiser</div><h1 class="section-title">Event management</h1></div><a asp-action="Create" class="btn btn-warning fw-bold align-self-center">＋ New event</a></div><div class="card p-3 table-responsive"><table class="table"><thead><tr><th>Name</th><th>Date</th><th>Location</th><th>Distance</th><th>Actions</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.Name</td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@e.Location</td><td>@e.DistanceKm km</td><td><a asp-action="Edit" asp-route-id="@e.Id">Edit</a> · <a asp-action="Categories" asp-route-id="@e.Id">Categories</a> · <a asp-action="Enrolments" asp-route-id="@e.Id">Enrolments</a> · <a asp-action="Results" asp-route-id="@e.Id">Results</a><form asp-action="Delete" method="post" class="d-inline"><input type="hidden" name="id" value="@e.Id"/><button class="btn btn-link btn-sm text-danger" onclick="return confirm('Delete this event?')">Delete</button></form></td></tr>}</tbody></table></div>
