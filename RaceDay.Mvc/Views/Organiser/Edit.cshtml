@model EventVm
@{ViewData["Title"]="Edit event";}
<div class="row justify-content-center"><div class="col-lg-8"><div class="card p-4"><div class="eyebrow">Organiser · Event setup</div><h1 class="section-title">Edit event</h1><form method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Name" class="form-label">Event name</label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea><span asp-validation-for="Description" class="text-danger"></span></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="EventDate" class="form-label">Date and time</label><input asp-for="EventDate" type="datetime-local" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="DistanceKm" class="form-label">Distance (km)</label><input asp-for="DistanceKm" class="form-control"/><span asp-validation-for="DistanceKm" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="EventType" class="form-label">Event type</label><select asp-for="EventType" class="form-select"><option>Run</option><option>Walk</option><option>Cycle</option></select></div></div><div class="mb-3"><label asp-for="Banner" class="form-label">Event banner image (JPG, PNG or WebP, max 5 MB)</label><input asp-for="Banner" type="file" accept="image/png,image/jpeg,image/webp" class="form-control"/></div><button class="btn btn-warning fw-bold">Save event</button> <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a></form></div></div></div>
